# ==========================================
# OFFICE SERVICE DESK
# Configuracion del backend
# ==========================================

# Conexion MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=office_service_desk

# Usuario de la aplicacion
DB_USER=office_app
DB_PASSWORD=REEMPLAZAR_CON_CONTRASENA_PROPIA

# Usuario para migraciones de Alembic
MIGRATION_DB_USER=office_migrator
MIGRATION_DB_PASSWORD=REEMPLAZAR_CON_CONTRASENA_PROPIA

# Autenticacion JWT
# Generar una clave aleatoria de al menos 64 caracteres.
JWT_SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_PROPIA

ACCESS_TOKEN_EXPIRE_MINUTES=30

# Inteligencia artificial opcional
# Mantener desactivada para la primera instalacion.
AI_ENABLED=false

# Configurar solo si se habilita Gemini.
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Adjuntos
# Por defecto se utiliza backend/storage/attachments
# ATTACHMENTS_STORAGE_DIR=